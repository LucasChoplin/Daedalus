start : main3.o map.o atlas.o text.o
	gcc main3.o map.o atlas.o text.o -o start -lSDL2 -lSDL2_image -lSDL2_ttf

main3.o : main3.c structs.h
	gcc -c main3.c
map.o : system/map.c system/map.h system/atlas.h
	gcc -c system/map.c

atlas.o : system/atlas.c system/atlas.h
	gcc -c system/atlas.c

text.o : system/text.c system/text.h
	gcc -c system/text.c